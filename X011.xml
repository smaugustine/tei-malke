  <text>

    <body>
      <div type="edition" xml:lang="gez">

        

        <div type="textpart" xml:id="malke">
          
          <lg type="stanza" n="1">
            
            <l n="1">ሰላም፡ ሰላም፡ ለሠናየ፡ ዝክር፡ ዝክረ፡ ስምኪ፨</l>
            <l n="2">ወለሕብረ፡ ሜላት፡ ፍቱል፡ ሥዕርተ፡ ርእስኪ፨</l>
            <l n="3">እስመ፡ አንቲ፡ ቅድመ፡ መሠረተ፡ ቤታ፡ አፅናዕኪ፨</l>
            <l n="4">ትቤለኪ፡ ለስእለቱ፡ መርጡለ፡ ማርያም፡ ደብርኪ፨</l>
            <l n="5">እሌኒ፡ ንግሥት፡ በሐኪ፡ በሐኪ፨</l>

          </lg>
          
          <lg type="stanza" n="2">
            
            <l n="1">ሰላም፡ ለርእስኪ፡ ዘተቀጸለ፡ አክሊለ፡ ወርቅ፨</l>
            <l n="2">ወለገጽኪ፡ ብሩህ፡ እምሕብረ፡ መብረቅ፨</l>
            <l n="3">እሌኒ፡ ጸልዪ፡ እምኀበ፡ አምልካክኪ፡ ሊቅ፨</l>
            <l n="4">ደቂቅኪ፡ ጊዜ፡ መከራ፡ ወጊዜ፡ ሐዘን፡ ጽፉቅ፨</l>
            <l n="5">እስመ፡ ይሴፈዉ፡ ኪያኪ፡ በጽድቅ፨</l>

          </lg>
          
          <lg type="stanza" n="23">
            
            <l n="1">ሰላም፡ ለግንዘተ፡ ሥጋኪ፡ በእደ፡ ኅሩያን፡ ነገድ፨</l>
            <l n="2">ወለመቃብርኪ፡ ልዕልት፡ ደብረ፡ ነጐድጓድ፨</l>
            <l n="3">መርዓተ፡ ነጋሢ፡ እሌኒ፡ ክብርተ፡ ዘመድ፨</l>
            <l n="4">ንዒ፡ ንዒ፡ ንግሥትነ፡ መንገለ፡ ዛቲ፡ ዐጸድ፨</l>
            <l n="5">እስመ፡ ተጋብኡ፡ አእላፍ፡ ውሉድ፨</l>

          </lg>
          
          <lg type="stanza" n="24">
            
            <l n="1">ኦዘጸውዐኪ፡ እግዚአብሔር፡ አብ፨</l>
            <l n="2">ውስተ፡ ቤተ፡ መርዓ፡ እሌኒ፡ ወቤተ፡ ከብካብ፨</l>
            <l n="3">መክሊተ፡ ማሕሌት፡ ፈነወት፡ ምስለ፡ ነጋድያን፡ ሕዝብ፨</l>
            <l n="4">ልሳንየ፡ መሬታዊት፡ ንግሥተ፡ አዜብ፡ ወ[ድቡ]ብ፨</l>
            <l n="5">ለቅድስናኪ፡ ሰሎሞን፡ መክብብ፨</l>

          </lg>
          
        </div>

        
        
      </div>
